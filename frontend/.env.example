# ---------------------------------------------------------------------------
# HokieExchange — frontend environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Google OAuth (NextAuth / Auth.js) --------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Server-only shared secret, same as backend (at least 32 random characters).
CHAT_AUTH_SECRET=

# FastAPI backend origin, used by next.config.ts rewrites to proxy
# `/api/backend/*` → `${BACKEND_URL}/*` (server-side, never exposed to browser).
BACKEND_URL=http://127.0.0.1:8000

# --- Public variables (exposed to the browser) ------------------------------
# socket.io backend URL (WebSockets bypass the Vercel proxy; must be wss:// in prod)
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
