# ---------------------------------------------------------------------------
# HokieExchange — frontend environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Google OAuth (NextAuth / Auth.js) --------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Server-only shared secret, same as backend (at least 32 random characters).
CHAT_AUTH_SECRET=

# FastAPI backend URL used by the Next.js server (src/lib/backend-token.ts)
BACKEND_URL=http://127.0.0.1:8000

# --- Public variables (exposed to the browser) ------------------------------
# FastAPI backend URL used by the API layer (src/lib/api/client.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Chat/socket backend URL (src/chat/chatsignal/client.ts)
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
