# ---------------------------------------------------------------------------
# HokieExchange — frontend environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Public variables (exposed to the browser) ------------------------------
# FastAPI backend URL used by the API layer (src/lib/api/client.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Chat/socket backend URL (src/chat/chatsignal/client.ts)
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000

# --- Server-only secrets (NO `NEXT_PUBLIC_` prefix — read only in server code)
# Replace placeholders with real values in `.env.local`, never here:
# JWT_SECRET=your_jwt_secret_here
# SSO_CLIENT_SECRET=your_sso_client_secret_here
