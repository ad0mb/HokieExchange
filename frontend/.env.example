# Copy to frontend/.env.local locally, or set these in Vercel and redeploy.
# Google login returns to the frontend, which contacts the backend server-side.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
CHAT_AUTH_SECRET=
AUTH_TRUST_HOST=true
# On Vercel production use https://hokie-exchange.us instead.
AUTH_URL=http://localhost:3000

# Server-only VM origin. Use http://127.0.0.1:8000 for a local backend.
BACKEND_URL=http://159.65.221.172:8000
# REST and Socket.IO polling use /api/backend on the current website origin.
# No NEXT_PUBLIC_API_URL or NEXT_PUBLIC_CHAT_API_URL is needed.