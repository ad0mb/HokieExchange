# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The driver-qualified scheme (mysql+pymysql://) is required so SQLAlchemy uses pymysql.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/DATABASE
# Same random value on the frontend server; at least 32 characters.
CHAT_AUTH_SECRET=
CHAT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosted agent credentials: backend only. Never use NEXT_PUBLIC_ for these.
DATABRICKS_TOKEN=

# Genie Agent (same workspace and Agent ID shown in Configure > About).
DATABRICKS_HOST=https://dbc-58438457-4d5a.cloud.databricks.com
DATABRICKS_GENIE_SPACE_ID=01f1b4d261b51558aed7abf9ae01cfdd
